<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0">
    <proxies>
        <proxy>
            <id>old-proxy</id>
            <active>true</active>
            <protocol>http</protocol>
            <host>invalid.invalid</host>
            <port>1</port>
        </proxy>
    </proxies>
    <mirrors>
        <mirror>
            <id>fixture</id>
            <url>${env.FIXTURE_REPOSITORY}</url>
            <mirrorOf>*</mirrorOf>
        </mirror>
    </mirrors>
    <profiles>
        <profile>
            <id>fixture</id>
            <properties>
                <fixture.version>4.13.2</fixture.version>
            </properties>
        </profile>
    </profiles>
    <activeProfiles>
        <activeProfile>fixture</activeProfile>
    </activeProfiles>
</settings>
